# Auto detect text files and perform LF normalization
* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
*.c text eol=lf
*.h text eol=lf
*.asm text eol=lf
*.adoc text eol=lf
*.md text eol=lf

# Preserve map JSON bytes for deterministic generated images
modules/Tank-16/disks/maps/*.json -text
